---
import * as shiki from 'shiki';
import { runnableCodeFor } from '../lib/sandbox/runnable-command.js';

const { code, language, highlightLines = [], executeLines = [] } = Astro.props;

let codeHTML = '';

const highlighter = await shiki.createHighlighter({
    themes: ['github-dark'],
    langs: ['shell', 'shellsession', "powershell", "vb", "js", "py", "c", "c#", "c++", "rust"]
});
codeHTML = await highlighter.codeToHtml(code, {
    lang: language, theme: 'github-dark',
})
highlighter.dispose();

const languages = ["shell", "shellsession", "bash", "zsh", "sh", "console"]

const runnableCode = runnableCodeFor(code, language, executeLines);

if (highlightLines.length > 0) {
    const lines = codeHTML.split(/\r?\n/);
    codeHTML = lines
    .map((lineHtml, index) => {
      const lineNumber = index + 1;
      if (highlightLines.includes(lineNumber)) {
        return lineHtml.replace(
          /class="([^"]*)"/,
          'class="$1 highlight"'
        );
      }
      return lineHtml;
    })
    .join("\n");
}
---

<div class="relative bg-[#24292e] rounded-lg mb-4" data-code={code}>
   <div class="flex items-center gap-2 px-3 py-1 bg-zinc-800 rounded-md text-sm font-mono select-none">
        <span class="px-2 py-0.5 bg-zinc-700 rounded text-xs font-semibold text-zinc-200 uppercase">
            {language}
        </span>
        
        <button
        class="flex items-center justify-center w-6 h-6 rounded hover:bg-zinc-700 text-zinc-400 hover:text-white"
        title="Collapse codeblock"
        >
        <span class="material-icons text-[16px] transition-all duration-200">expand_more</span>
        <script is:inline>
        (() => {
        const btn = document.currentScript?.parentElement;
        const content = btn.parentElement.parentElement.getElementsByClassName("codeblock");
        if (!btn || !content) return;

        btn.addEventListener("click", () => {
            const expanded = content[0].classList.toggle("max-h-[0px]");
            content[0].classList.toggle("opacity-100", !expanded);
            content[0].classList.toggle("opacity-0", expanded);
            content[0].classList.toggle("p-4", !expanded);
            btn.querySelector("span").classList.toggle("rotate-180", expanded)
        });
        })();
        </script>
        </button>
        <button
            class="flex items-center justify-center w-6 h-6 rounded hover:bg-zinc-700 text-zinc-400 hover:text-white transition"
            title="Copy"
        >
            <span class="material-icons text-[16px]">content_copy</span>
            <script is:inline>
                (() => {
                    const btn = document.currentScript.parentElement;
                    const container = btn?.closest("[data-code]");
                    if (!btn || !container) return;

                    btn.addEventListener("click", () => {
                    const codeText = container.dataset.code;
                    if (!codeText) return;

                    navigator.clipboard.writeText(codeText).then(() => {
                        if (window.spawnAlert) {
                        window.spawnAlert({ message: "Copied to clipboard!", type: "normal" });
                        }
                    });
                    });
                })();
            </script>
        </button>

        {languages.includes(language) && runnableCode && (
            <button
            class="flex items-center justify-center w-6 h-6 rounded hover:bg-zinc-700 text-zinc-400 hover:text-white transition"
            title="Try in sandbox"
            data-run-code={runnableCode}
            >
            <span class="material-icons text-[16px]">terminal</span>
            <script is:inline>
              (() => {
                const btn = document.currentScript.parentElement;
                if (!btn) return;

                btn.addEventListener("click", () => {
                  const code = btn.dataset.runCode || "";
                  const encoded = btoa(unescape(encodeURIComponent(code)))
                    .replace(/\+/g, "-")
                    .replace(/\//g, "_")
                    .replace(/=+$/, "");
                  window.location.href = `/sandbox?c=${encoded}`;
                });
              })();
            </script>
            </button>
        )}

  </div>
  <div class="p-4 font-mono text-sm overflow-x-auto codeblock transition-all duration-500" set:html={codeHTML}></div>
  
</div>
