---
type Page = { label: string; route: string; active?: boolean };
type Section = { name: string; pages: (Page | Section)[]; active:boolean };

const { item } = Astro.props as { item: Page | Section };
const isSection = (x: Page | Section): x is Section => 'pages' in x;
if (isSection(item) && !item.active) {item.active = true};

import Self from "./SidebarSection.astro";
---

{isSection(item) ? (
  <li class="relative">
    <div
      class="text-xs uppercase text-zinc-500 mt-2 mb-1 cursor-pointer select-none flex items-center justify-between"
      onclick="this.nextElementSibling.classList.toggle('hidden'); this.querySelector('.arrow').classList.toggle('rotate-180')"
    >
      {item.name}
      <span class="material-icons text-zinc-400 text-xs arrow transition-transform duration-300">
        expand_more
      </span>
    </div>

    <ul class={`ml-4 space-y-1 ${item.active ? '' : 'hidden'} relative`}>
      {item.pages.map((subItem, i) => (
        <Self key={i} item={subItem} />
      ))}
      <span class="absolute top-0 -left-2 w-[1px] bg-zinc-600 h-full"></span>
    </ul>
  </li>
) : (
  <li class={`cursor-pointer hover:text-white ${item.active ? 'font-bold text-blue-400' : 'text-zinc-300'}`}>
    <a href={item.route}>{item.label}</a>
  </li>
)}